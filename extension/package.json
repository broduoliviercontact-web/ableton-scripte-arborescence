{
  "name": "ableton-session-mapper",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "main": "dist/extension.js",
  "scripts": {
    "build": "tsc --noEmit && tsx build.ts",
    "build:release": "tsc --noEmit && tsx build.ts --production",
    "start": "SESSION_MAPPER_RUNTIME_MODE=dev tsx build.ts && extensions-cli run --storage-directory .. --temp-directory .tmp"
  },
  "dependencies": {
    "@ableton-extensions/sdk": "file:../../../Downloads/extensions-sdk-1.0.0-beta.0/ableton-extensions-sdk-1.0.0-beta.0.tgz"
  },
  "devDependencies": {
    "@ableton-extensions/cli": "file:../../../Downloads/extensions-sdk-1.0.0-beta.0/ableton-extensions-cli-1.0.0-beta.0.tgz",
    "@types/node": "^22.10.0",
    "esbuild": "0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
