{
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "esModuleInterop": true,
    "noEmit": true,
    "rootDir": "..",
    "types": ["node"]
  },
  "include": [
    "src/**/*",
    "../viewer-simple/template.ts",
    "../session-grid/generateSessionGrid.ts",
    "../launcher/diagramsIndexTemplate.ts",
    "../metro/generateMetroView.ts",
    "../mermaid/generateMermaid.ts",
    "../mermaid/generateMermaidHtml.ts"
  ]
}
